{
  "name": "@sc2mcp/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "sc2-mcp": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "start": "node ./dist/main.js",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@sc2mcp/core": "workspace:*",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@sc2mcp/test-utils": "workspace:*"
  }
}
